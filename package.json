{
  "name": "hydrate-buddy",
  "displayName": "Hydrate Buddy",
  "description": "Your coding buddy for water breaks. A cute animated mascot (superhero, dragon, pocket monster, rubber duck, robot, cat and more) reminds you to drink water, stays in sync across all your VS Code windows, and keeps every stat on your machine.",
  "version": "1.3.1",
  "publisher": "hydrate-buddy",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#d6efff",
    "theme": "light"
  },
  "pricing": "Free",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "water",
    "hydration",
    "reminder",
    "health",
    "wellness",
    "break",
    "mascot",
    "pet",
    "productivity",
    "developer",
    "focus",
    "timer"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "hydrateBuddy.showDashboard",
        "title": "Show Dashboard",
        "category": "Hydrate Buddy",
        "icon": "$(dashboard)"
      },
      {
        "command": "hydrateBuddy.chooseMascot",
        "title": "Choose Your Buddy",
        "category": "Hydrate Buddy"
      },
      {
        "command": "hydrateBuddy.remindNow",
        "title": "Remind Me Now",
        "category": "Hydrate Buddy"
      },
      {
        "command": "hydrateBuddy.logWater",
        "title": "I Drank Water",
        "category": "Hydrate Buddy"
      },
      {
        "command": "hydrateBuddy.snooze",
        "title": "Snooze Reminder",
        "category": "Hydrate Buddy"
      },
      {
        "command": "hydrateBuddy.toggle",
        "title": "Enable / Disable Reminders",
        "category": "Hydrate Buddy"
      },
      {
        "command": "hydrateBuddy.setInterval",
        "title": "Set Reminder Interval",
        "category": "Hydrate Buddy"
      },
      {
        "command": "hydrateBuddy.resetToday",
        "title": "Reset Today's Count",
        "category": "Hydrate Buddy"
      }
    ],
    "configuration": {
      "title": "Hydrate Buddy",
      "properties": {
        "hydrateBuddy.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Enable water-break reminders."
        },
        "hydrateBuddy.intervalMinutes": {
          "type": "number",
          "default": 45,
          "minimum": 1,
          "maximum": 480,
          "scope": "application",
          "description": "Minutes between water-break reminders."
        },
        "hydrateBuddy.snoozeMinutes": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 120,
          "scope": "application",
          "description": "Minutes to wait when you press Snooze."
        },
        "hydrateBuddy.dailyGoal": {
          "type": "number",
          "default": 8,
          "minimum": 1,
          "maximum": 50,
          "scope": "application",
          "description": "Number of water breaks you aim for each day."
        },
        "hydrateBuddy.reminderStyle": {
          "type": "string",
          "enum": [
            "mascot",
            "notification"
          ],
          "enumDescriptions": [
            "Show the animated droplet buddy in a small panel beside your editor.",
            "Show a regular VS Code notification instead."
          ],
          "default": "mascot",
          "scope": "application",
          "description": "How the reminder is shown."
        },
        "hydrateBuddy.mascot": {
          "type": "string",
          "enum": [
            "drip",
            "hero",
            "splashy",
            "ember",
            "duck",
            "robot",
            "cat",
            "random"
          ],
          "enumItemLabels": [
            "Drip",
            "Captain Hydro",
            "Splashy",
            "Ember",
            "Quackers",
            "Bit",
            "Mochi",
            "Surprise me"
          ],
          "enumDescriptions": [
            "Classic: the original droplet buddy.",
            "Superhero: a caped crusader who never lets a teammate go thirsty.",
            "Pocket monster: a wild water-type critter.",
            "Fantasy dragon: even dragons hydrate.",
            "Rubber duck: your debugging partner.",
            "Robot: monitors your coolant levels.",
            "Dev cat: sits on your keyboard until you drink.",
            "A different buddy for every reminder."
          ],
          "default": "drip",
          "scope": "application",
          "description": "Which buddy reminds you to drink water."
        },
        "hydrateBuddy.showStatusBar": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Show the next-reminder countdown in the status bar."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "node -e \"require('fs').rmSync('out',{recursive:true,force:true})\" && tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js",
    "test:unit": "npm run compile && mocha --ui tdd \"out/test/unit/**/*.test.js\"",
    "package": "vsce package --allow-missing-repository",
    "publish": "vsce publish --allow-missing-repository"
  },
  "overrides": {
    "cheerio": "1.0.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.3.9",
    "@vscode/vsce": "^2.26.0",
    "mocha": "^10.4.0",
    "typescript": "^5.4.5"
  }
}
